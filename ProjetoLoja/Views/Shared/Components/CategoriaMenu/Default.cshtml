<div class="dropdown">
    <a class="btn btn-secondary dropdown-toogle" role="button"
       id="dropdownMenuLink" data-bs-toogle="dropdown" aria-expanded="false">
        Produtos
    </a>
    <ul class="dropdown-menu">
        @foreach (var categoria in Model)
        {
            <li>
                <a class="dropdown-item" asp-controller="Produto" asp-action="Index" style="color: black"
                   asp-route-categoria="@categoria.NomeCategoria">@categoria.NomeCategoria</a>
            </li>
            
            <li class="dropdown-divider"></li>
            <li>
                <a class="dropdown-item" asp-controller="Produto" asp-action="Index"
                   asp-route-categoria="" style="color: black">
                    Todos os Produtos
                </a>
            </li>
        }
    </ul>
</div>