@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <form asp-area="" asp-controller="Accont" asp-action="Logout" id="logoutForm"
          method="post" class="navbar-left">
        <ul class="nav navbar-nav navbar-left">
            <button type="submit" style="width: auto" class="nav-link btn btn-link py-0"/>
        </ul>
    </form>
}
<ul class="nav navbar-nav navbar-left">
    <a class="nav-link text-light" asp-controller="Accont" asp-action="Login" asp-route-returnUrl="@string.Format("{0}{1}", Context.Request.Path, Context.Request.Query)">&nbsp;Login;&nbsp;&nbsp;</a>
    <a class="nav-link text-light" asp-controller="Accont" asp-action="Register" style="color: #2c3034">&nbsp;Registro;&nbsp;&nbsp;</a>
</ul>