@model Produto

@{
    ViewData["Title"] = "Detalhes do Produto";
}

<div class="container">
    <div class="row">
        <div class="card">
            
            <div class="text-center">
                <img src="@Model.UrlImagem" class="img-fluid" alt=""></img>
            </div>
            <div class="text-center">
                <img src="@Model.UrlImagem" class="img-fluid" alt=""></img>
            </div>
            <div class="card-block">
                <h2 class="card-title">@Model.NomeProduto</h2>
                <p class="card-text">
                    @Model.Descricao
                </p>
                        <p class="btn btn-group align-content-lg-center">
                            <a asp-controller="Produto" asp-action="Index"
                               class="btn btn-outline-info">Ver todos os produtos
                            </a>
                            <a class="btn btn-primary" id="cartButton" asp-controller="CarrinhoCompra"
                               asp-action="AddProduto" asp-route-produtoId="@Model.IdProduto">
                                Adicionar @Model.NomeProduto ao carrinho
                            </a>
                        </p>
            </div>
        </div>
    </div>
</div>